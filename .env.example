DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-this-for-local-development
USE_SQLITE=False

# PostgreSQL connection components for an authorised development database.
# PGHOST must be Neon's direct hostname (without `-pooler`). Runtime derives
# the pooled Neon hostname; migrations set POLSK_DATABASE_CONNECTION_MODE=direct.
PGHOST=
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGSSLMODE=require
PGCHANNELBINDING=require

# Used only by the protected scheduled database keepalive endpoint.
KEEPALIVE_SECRET=

# Optional public host and origin for local configuration parity with deployment.
# APP_HOST is a hostname without a scheme; APP_ORIGIN includes its scheme.
APP_HOST=
APP_ORIGIN=

# Private Starti configuration. Never commit a real API key.
STARTIAPP_BRAND_NAME=
STARTIAPP_API_KEY=
STARTIAPP_ENVIRONMENT_TAG=development

# Deliver configured Starti pushes in the originating request after its database
# transaction commits. Set to False only when a separate dispatcher is enabled.
NOTIFICATION_DELIVERY_SYNCHRONOUS=True
